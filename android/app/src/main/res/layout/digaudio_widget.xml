<?xml version="1.0" encoding="utf-8"?>
<!--
  Homescreen widget mini-player. The whole tile is a RemoteViews tree
  (a strict subset of Android views — no Compose / no custom widgets).

  Layout: leading 48 dp app icon · centred title + artist (taking the
  remaining width) · play/pause + skip-next on the trailing edge. Tap
  on the leading + text area opens the app (PendingIntent set in
  Kotlin); the two trailing buttons fire media-button broadcasts via
  WidgetClickReceiver.

  Background colour matches the dark scaffold; the system honours it
  on light-theme launchers too because RemoteViews don't get themed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FF18181B"
    android:padding="8dp">

    <!-- Artwork slot. Defaults to the launcher icon when nothing's
         playing or while the Dart-side prefetch is in flight; swapped
         for the current track's 256 px JPEG by setImageViewBitmap once
         WidgetChannel receives an artworkPath. -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Now playing" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="digaudio" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFBBBBBB"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nothing playing" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_media_play"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Play / pause" />

    <ImageButton
        android:id="@+id/widget_skip_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_media_next"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Skip next" />

</LinearLayout>
